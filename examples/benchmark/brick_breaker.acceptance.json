{
  "supported": true,
  "reason": "",
  "title": "brick_breaker independent acceptance",
  "development_plan": [
    "Held-out checks authored before generation"
  ],
  "state_contract": {
    "phase": "Real live phase; exact paths only used where required by spec"
  },
  "requirements": [
    {
      "id": "R1",
      "text": "Visible surface and initial counters",
      "verification": "automated",
      "priority": "core"
    },
    {
      "id": "R2",
      "text": "Normal keys move paddle",
      "verification": "automated",
      "priority": "core"
    },
    {
      "id": "R3",
      "text": "Pause freezes the actual ball",
      "verification": "automated",
      "priority": "core"
    },
    {
      "id": "R4",
      "text": "First actual brick collision scores once",
      "verification": "automated",
      "priority": "core"
    },
    {
      "id": "R5",
      "text": "Restart from pause resets counters and state",
      "verification": "automated",
      "priority": "core"
    }
  ],
  "tests": [
    {
      "id": "T1",
      "description": "Visible surface and initial counters",
      "requirement_ids": [
        "R1"
      ],
      "steps": [
        {
          "action": "assert",
          "source": "surface",
          "selector": "canvas",
          "property": "width",
          "op": "eq",
          "value": 480
        },
        {
          "action": "assert",
          "source": "surface",
          "selector": "canvas",
          "property": "height",
          "op": "eq",
          "value": 360
        },
        {
          "action": "assert",
          "source": "text",
          "selector": "#score",
          "op": "eq",
          "value": "0"
        },
        {
          "action": "assert",
          "source": "text",
          "selector": "#lives",
          "op": "eq",
          "value": "3"
        },
        {
          "action": "assert",
          "source": "text",
          "selector": "#status",
          "op": "eq",
          "value": "Ready"
        }
      ]
    },
    {
      "id": "T2",
      "description": "Normal keys move paddle",
      "requirement_ids": [
        "R2"
      ],
      "steps": [
        {
          "action": "click",
          "selector": "#start"
        },
        {
          "action": "capture",
          "name": "before"
        },
        {
          "action": "key",
          "key": "ArrowLeft",
          "hold_ms": 150
        },
        {
          "action": "assert",
          "source": "state",
          "path": "paddle.x",
          "op": "lt",
          "value_from": {
            "capture": "before",
            "path": "paddle.x"
          }
        }
      ]
    },
    {
      "id": "T3",
      "description": "Pause freezes the actual ball",
      "requirement_ids": [
        "R3"
      ],
      "steps": [
        {
          "action": "click",
          "selector": "#start"
        },
        {
          "action": "wait",
          "ms": 150
        },
        {
          "action": "click",
          "selector": "#pause"
        },
        {
          "action": "capture",
          "name": "paused"
        },
        {
          "action": "wait",
          "ms": 400
        },
        {
          "action": "assert",
          "source": "state",
          "path": "ball.y",
          "op": "eq",
          "value_from": {
            "capture": "paused",
            "path": "ball.y"
          }
        },
        {
          "action": "assert",
          "source": "text",
          "selector": "#status",
          "op": "eq",
          "value": "Paused"
        }
      ]
    },
    {
      "id": "T4",
      "description": "First actual brick collision scores once",
      "requirement_ids": [
        "R4"
      ],
      "steps": [
        {
          "action": "click",
          "selector": "#start"
        },
        {
          "action": "wait_until",
          "until": {
            "source": "text",
            "selector": "#score",
            "op": "eq",
            "value": "10"
          },
          "timeout_ms": 3000
        },
        {
          "action": "assert",
          "source": "text",
          "selector": "#score",
          "op": "eq",
          "value": "10"
        }
      ]
    },
    {
      "id": "T5",
      "description": "Restart from pause resets counters and state",
      "requirement_ids": [
        "R5"
      ],
      "steps": [
        {
          "action": "click",
          "selector": "#start"
        },
        {
          "action": "wait",
          "ms": 250
        },
        {
          "action": "click",
          "selector": "#pause"
        },
        {
          "action": "click",
          "selector": "#restart"
        },
        {
          "action": "assert",
          "source": "text",
          "selector": "#status",
          "op": "eq",
          "value": "Ready"
        },
        {
          "action": "assert",
          "source": "text",
          "selector": "#score",
          "op": "eq",
          "value": "0"
        },
        {
          "action": "assert",
          "source": "text",
          "selector": "#lives",
          "op": "eq",
          "value": "3"
        },
        {
          "action": "assert",
          "source": "state",
          "path": "ball.y",
          "op": "eq",
          "value": 250
        }
      ]
    }
  ],
  "manual_checks": []
}
