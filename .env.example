# Copy to .env; never commit or share .env. Only an API key, not your account password.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Model used in this project's local tests. Set an ID actually available to your account.
LLM_MODEL=deepseek-flash
# DeepSeek-specific option. Set blank when using another compatible provider.
LLM_THINKING=disabled
LLM_JSON_MODE=true
LLM_MAX_TOKENS=12000
LLM_TIMEOUT_SECONDS=90
# Blank uses Playwright Chromium. msedge uses an already installed Microsoft Edge.
PLAYWRIGHT_CHANNEL=
# Optional actual price per 1M tokens. Leave blank: report tokens, not invented cost.
# Currency is a label only. Use the same currency for all three rates.
PRICE_INPUT_PER_MILLION=
PRICE_CACHED_INPUT_PER_MILLION=
PRICE_OUTPUT_PER_MILLION=
PRICE_CURRENCY=USD
